{
  "name": "floorish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^5.3.0",
    "konva": "^10.9.1",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
